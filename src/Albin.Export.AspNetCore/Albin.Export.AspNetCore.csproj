<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Albin.Export.AspNetCore</PackageId>
    <Description>
      ASP.NET Core integration for Albin.Export: one-line file results for controllers and minimal
      APIs, streaming responses that skip the memory buffer, content negotiation from a format query
      value, and Razor view/page rendering into an export result.
    </Description>
    <RootNamespace>Albin.Export.AspNetCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Albin.Export\Albin.Export.csproj" />
  </ItemGroup>

</Project>
