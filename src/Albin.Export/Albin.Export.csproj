<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Albin.Export</PackageId>
    <Description>
      Core abstractions for the Albin.Export framework: IExporter, IExportService, ExportRequest,
      ExportResult, ExportFormat, ExportOptions and a lightweight document/table model.
      Install the format-specific packages (Albin.Export.Pdf, Albin.Export.Excel, ...) to add exporters.
    </Description>
    <RootNamespace>Albin.Export</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
